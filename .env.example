# 수행 데이터 전송 (없으면 전송이 통째로 꺼지고 게임은 그대로 돌아간다)
#
# 실값은 이 파일이 아니라 .gitignore 된 `.env` 에 넣는다.
# 이 저장소는 공개이고, 이 키는 SELECT 는 막혀 있지만 4개 테이블에 INSERT 가 된다.
# 공개된 자리에 실값을 두면 데이터가 새지는 않아도 누구나 연구 데이터셋을 오염시킬 수 있다.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<publishable-key>

# 기관 코드 — 리포트에서 이 값으로 묶인다. 행사·부스마다 바꿔서 쓴다.
# ★ 반드시 서버의 `site` 테이블에 등록된 코드여야 한다.
#   등록되지 않은 값이면 세션 종료(close_session)가 report FK 위반(409)으로 실패하고,
#   4xx 는 재시도하지 않으므로 팀 점수·완주 여부가 조용히 유실된다.
VITE_SITE_CODE=demo

# 키오스크 식별자. 기기가 여러 대면 다르게 준다.
VITE_DEVICE_ID=kiosk-01

# 콘텐츠 코드. T(인지표적)·I(상호의존 패턴)가 확정되면 이 값만 바꾼다.
# 게임 코드에 박지 않는다 — 표적이 바뀔 때 게임을 다시 건드리지 않기 위한 것이다.
VITE_CONTENT_ID=tmp-orak-flag
